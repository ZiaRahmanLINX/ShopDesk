{
  "name": "shopdesk",
  "version": "1.0.0",
  "description": "ShopDesk \u2014 Windows desktop shop management & partnership accounting (PKR)",
  "author": "ShopDesk",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json && rm -rf dist-electron/main/generated-prisma && cp -r src/main/generated-prisma dist-electron/main/generated-prisma",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "build": "npm run prisma:generate && npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "seed": "tsx scripts/seed.ts",
    "test:scenarios": "tsx tests/scenarios.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@prisma/engines": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^36.3.0",
    "electron-builder": "^26.0.12",
    "prisma": "^6.8.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}